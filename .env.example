# ============================================================
#  DeepSeek API 配置（复制本文件为 .env 后填写）
# ============================================================
#
# 后端会按下面的优先级自动查找 API Key，任选一种即可：
#
#   1. 系统环境变量 DEEPSEEK_API_KEY
#   2. 系统环境变量 DEEPSEEK_KEY / DS_API_KEY / DEEPSEEK_TOKEN
#   3. 项目根目录的 .env 文件（即本文件重命名为 .env）
#   4. 本机凭据文件 ~/.dsh/.credentials.yaml 中的 DEEPSEEK_API_KEY
#
# 优先级从上到下，先找到的先用。

# 必填：你的 DeepSeek API Key（在 https://platform.deepseek.com 申请）
# 格式是一串以 sk- 开头的字符。
# 留空也能跑：后端会自动降级为内置模板文案，界面功能完全正常，只是文案不是 AI 写的。
DEEPSEEK_API_KEY=

# 选填：接口地址（默认官方）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 选填：模型名（deepseek-chat / deepseek-reasoner）
# DEEPSEEK_MODEL=deepseek-chat

# 选填：单次请求超时（毫秒）
# DEEPSEEK_TIMEOUT_MS=120000

# 选填：后端监听地址与端口
# HOST=127.0.0.1
# PORT=8787

# 选填：前端独立开发服务器端口
# WEB_DEV_PORT=5173

# 选填：设为 0 可在启动时不自动补齐缺失的 AI 文案
# AUTO_GENERATE_COPY=1
