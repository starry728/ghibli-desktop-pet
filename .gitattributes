# 统一换行符处理，避免跨平台 diff 噪音
* text=auto

# 明确标记二进制，防止 git 试图做行尾转换
*.exe   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.mp3   binary
*.wav   binary

# Windows 脚本保持 CRLF
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 让 GitHub 的语言统计更准确（避免把生成数据当成主要语言）
server/data/pets.json          linguist-generated
server/data/scraped-characters.json linguist-generated
public/voice/clips.json        linguist-generated
